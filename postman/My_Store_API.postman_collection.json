{
  "info": {
    "_postman_id": "e8a7d3d6-4b7c-40d3-9fa5-1aaf4b2a0c10",
    "name": "My Store API - localhost",
    "description": "Collection para testes locais. Preencha email e password, execute Login e depois informe os IDs retornados nas variaveis store_id, category_id, customer_id, order_id e product_id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "email", "value": "admin@local.test" },
    { "key": "password", "value": "12345678" },
    { "key": "store_id", "value": "ABC123" },
    { "key": "category_id", "value": "1" },
    { "key": "product_id", "value": "1" },
    { "key": "customer_id", "value": "ID_DA_CONTA_CLIENTE" },
    { "key": "order_id", "value": "1" },
    { "key": "sale_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Autenticacao",
      "item": [
        {
          "name": "Login - obter JWT",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('access_token', body.access);", "pm.collectionVariables.set('refresh_token', body.refresh);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }, "url": "{{base_url}}/api/v1/authentication/token/" }
        },
        {
          "name": "Renovar JWT",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}" }, "url": "{{base_url}}/api/v1/authentication/token/refresh/" }
        }
      ]
    },
    {
      "name": "Usuarios e clientes",
      "item": [
        {
          "name": "Cadastrar usuario comum (customer) - form-data",
          "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [
            { "key": "email", "value": "cliente@local.test", "type": "text" },
            { "key": "password", "value": "12345678", "type": "text" },
            { "key": "first_name", "value": "Joao", "type": "text" },
            { "key": "last_name", "value": "Silva", "type": "text" },
            { "key": "telephone", "value": "11999999999", "type": "text" },
            { "key": "address", "value": "Rua das Flores", "type": "text" },
            { "key": "house_number", "value": "123", "type": "text" },
            { "key": "coins", "value": "0", "type": "text" },
            { "key": "image", "type": "file", "src": "" }
          ] }, "url": "{{base_url}}/api/v1/customers/register/" }
        },
        {
          "name": "Cadastrar conta de loja (somente admin) - form-data",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "formdata", "formdata": [
            { "key": "email", "value": "lojista@local.test", "type": "text" }, { "key": "username", "value": "lojista", "type": "text" }, { "key": "password", "value": "12345678", "type": "text" }, { "key": "first_name", "value": "Maria", "type": "text" }, { "key": "last_name", "value": "Souza", "type": "text" }, { "key": "telephone", "value": "11988888888", "type": "text" }
          ] }, "url": "{{base_url}}/api/v1/accounts/register/" }
        },
        { "name": "Minha conta", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{base_url}}/api/v1/accounts/" } }
      ]
    },
    {
      "name": "Preparacao da loja",
      "item": [
        {
          "name": "Criar loja - form-data",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "formdata", "formdata": [
            { "key": "name", "value": "Mercado Local", "type": "text" }, { "key": "slog", "value": "Perto de voce", "type": "text" }, { "key": "phone", "value": "11999999999", "type": "text" }, { "key": "address", "value": "Av. Principal, 100", "type": "text" }, { "key": "cnpj", "value": "12.345.678/0001-90", "type": "text" }, { "key": "instagram_url", "value": "https://instagram.com/mercadolocal", "type": "text" }, { "key": "image", "type": "file", "src": "" }
          ] }, "url": "{{base_url}}/api/v1/stores/" }
        },
        {
          "name": "Criar categoria - form-data",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "formdata", "formdata": [
            { "key": "store", "value": "{{store_id}}", "type": "text" }, { "key": "name", "value": "Bebidas", "type": "text" }, { "key": "description", "value": "Bebidas geladas e nao alcoolicas", "type": "text" }
          ] }, "url": "{{base_url}}/api/v1/categories/" }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Cadastrar produto - form-data",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "formdata", "formdata": [
            { "key": "store", "value": "{{store_id}}", "type": "text" }, { "key": "name", "value": "Refrigerante Cola 2L", "type": "text" }, { "key": "category", "value": "{{category_id}}", "type": "text" }, { "key": "description", "value": "Refrigerante gelado de 2 litros", "type": "text" }, { "key": "price", "value": "9.90", "type": "text" }, { "key": "stock", "value": "30", "type": "text" }, { "key": "crop_x", "value": "0", "type": "text" }, { "key": "crop_y", "value": "0", "type": "text" }, { "key": "crop_width", "value": "1024", "type": "text" }, { "key": "crop_height", "value": "1024", "type": "text" }, { "key": "image", "type": "file", "src": "" }
          ] }, "url": "{{base_url}}/api/v1/products/" }
        },
        { "name": "Listar produtos da loja", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{base_url}}/api/v1/products/?store={{store_id}}" } }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar pedido - form-data",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "X-Store-ID", "value": "{{store_id}}" }], "body": { "mode": "formdata", "formdata": [
            { "key": "customer", "value": "{{customer_id}}", "type": "text" }, { "key": "name_customer", "value": "Joao Silva", "type": "text" }, { "key": "phone", "value": "11999999999", "type": "text" }, { "key": "address", "value": "Rua das Flores", "type": "text" }, { "key": "house_number", "value": "123", "type": "text" }, { "key": "observation", "value": "Entregar na portaria", "type": "text" }, { "key": "latitude", "value": "-23.550520", "type": "text" }, { "key": "longitude", "value": "-46.633308", "type": "text" }, { "key": "subtotal", "value": "19.80", "type": "text" }, { "key": "rate_delivery", "value": "5.00", "type": "text" }, { "key": "total", "value": "24.80", "type": "text" }, { "key": "remaining", "value": "0.00", "type": "text" }, { "key": "payment_method", "value": "pix", "type": "text" }, { "key": "itens", "value": "[{\"id\": {{product_id}}, \"name\": \"Refrigerante Cola 2L\", \"price\": 9.90, \"quantity\": 2}]", "type": "text" }
          ] }, "url": "{{base_url}}/api/v1/orders/" }
        },
        { "name": "Listar pedidos", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "X-Store-ID", "value": "{{store_id}}" }], "url": "{{base_url}}/api/v1/orders/" } },
        { "name": "Confirmar entrega - form-data", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "code", "value": "a1b2", "type": "text" }] }, "url": "{{base_url}}/api/v1/orders/{{order_id}}/confirm-delivery" } }
      ]
    },
    {
      "name": "Vendas",
      "item": [
        {
          "name": "Criar venda - form-data",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "X-Store-ID", "value": "{{store_id}}" }], "body": { "mode": "formdata", "formdata": [
            { "key": "order", "value": "{{order_id}}", "type": "text" }, { "key": "subtotal", "value": "19.80", "type": "text" }, { "key": "rate_delivery", "value": "5.00", "type": "text" }, { "key": "total", "value": "24.80", "type": "text" }, { "key": "remaining", "value": "0.00", "type": "text" }, { "key": "payment_method", "value": "pix", "type": "text" }, { "key": "collaborator", "value": "Maria", "type": "text" }, { "key": "observation", "value": "Venda gerada pelo Postman", "type": "text" }, { "key": "status", "value": "true", "type": "text" }
          ] }, "url": "{{base_url}}/api/v1/sales/" }
        },
        { "name": "Listar vendas", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "X-Store-ID", "value": "{{store_id}}" }], "url": "{{base_url}}/api/v1/sales/" } }
      ]
    }
  ]
}
